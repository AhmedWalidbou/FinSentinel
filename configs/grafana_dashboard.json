{
    "title": "FinSentinel — Production Dashboard",
    "uid": "finsentinel-prod",
    "version": 1,
    "schemaVersion": 38,
    "time": { "from": "now-1h", "to": "now" },
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "title": "Total Predictions",
        "type": "stat",
        "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
        "targets": [
          {
            "expr": "sum(finsentinel_predictions_total)",
            "legendFormat": "Total"
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "area"
        }
      },
      {
        "id": 2,
        "title": "Model Accuracy",
        "type": "stat",
        "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
        "targets": [
          {
            "expr": "finsentinel_model_accuracy",
            "legendFormat": "Accuracy"
          }
        ],
        "options": {
          "colorMode": "background",
          "thresholds": {
            "steps": [
              { "value": 0, "color": "red" },
              { "value": 0.7, "color": "yellow" },
              { "value": 0.8, "color": "green" }
            ]
          }
        }
      },
      {
        "id": 3,
        "title": "Model F1 Score",
        "type": "stat",
        "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
        "targets": [
          {
            "expr": "finsentinel_model_f1",
            "legendFormat": "F1 Score"
          }
        ],
        "options": {
          "colorMode": "background",
          "thresholds": {
            "steps": [
              { "value": 0, "color": "red" },
              { "value": 0.7, "color": "yellow" },
              { "value": 0.8, "color": "green" }
            ]
          }
        }
      },
      {
        "id": 4,
        "title": "Data Drift Score (PSI)",
        "type": "stat",
        "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
        "targets": [
          {
            "expr": "finsentinel_data_drift_score",
            "legendFormat": "PSI"
          }
        ],
        "options": {
          "colorMode": "background",
          "thresholds": {
            "steps": [
              { "value": 0, "color": "green" },
              { "value": 0.1, "color": "yellow" },
              { "value": 0.25, "color": "red" }
            ]
          }
        }
      },
      {
        "id": 5,
        "title": "Prediction Rate (per minute)",
        "type": "timeseries",
        "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "rate(finsentinel_predictions_total[1m])",
            "legendFormat": "{{label}}"
          }
        ]
      },
      {
        "id": 6,
        "title": "API Latency p95 (seconds)",
        "type": "timeseries",
        "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(finsentinel_prediction_latency_seconds_bucket[5m]))",
            "legendFormat": "p95 latency"
          },
          {
            "expr": "histogram_quantile(0.50, rate(finsentinel_prediction_latency_seconds_bucket[5m]))",
            "legendFormat": "p50 latency"
          }
        ]
      },
      {
        "id": 7,
        "title": "Sentiment Distribution",
        "type": "piechart",
        "gridPos": { "x": 0, "y": 12, "w": 8, "h": 8 },
        "targets": [
          {
            "expr": "finsentinel_sentiment_ratio",
            "legendFormat": "{{label}}"
          }
        ]
      },
      {
        "id": 8,
        "title": "Confidence Score (last prediction)",
        "type": "gauge",
        "gridPos": { "x": 8, "y": 12, "w": 8, "h": 8 },
        "targets": [
          {
            "expr": "finsentinel_confidence_score",
            "legendFormat": "Confidence"
          }
        ],
        "options": {
          "minValue": 0,
          "maxValue": 1,
          "thresholds": {
            "steps": [
              { "value": 0, "color": "red" },
              { "value": 0.5, "color": "yellow" },
              { "value": 0.75, "color": "green" }
            ]
          }
        }
      },
      {
        "id": 9,
        "title": "API Errors",
        "type": "timeseries",
        "gridPos": { "x": 16, "y": 12, "w": 8, "h": 8 },
        "targets": [
          {
            "expr": "rate(finsentinel_api_errors_total[5m])",
            "legendFormat": "{{error_type}}"
          }
        ]
      },
      {
        "id": 10,
        "title": "API Requests by Endpoint",
        "type": "bargauge",
        "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
        "targets": [
          {
            "expr": "sum by (endpoint) (finsentinel_api_requests_total)",
            "legendFormat": "{{endpoint}}"
          }
        ]
      },
      {
        "id": 11,
        "title": "Data Drift Alert",
        "type": "stat",
        "gridPos": { "x": 12, "y": 20, "w": 6, "h": 8 },
        "targets": [
          {
            "expr": "finsentinel_data_drift_alert",
            "legendFormat": "Drift Alert"
          }
        ],
        "options": {
          "colorMode": "background",
          "thresholds": {
            "steps": [
              { "value": 0, "color": "green" },
              { "value": 1, "color": "red" }
            ]
          }
        }
      },
      {
        "id": 12,
        "title": "Active API Requests",
        "type": "stat",
        "gridPos": { "x": 18, "y": 20, "w": 6, "h": 8 },
        "targets": [
          {
            "expr": "finsentinel_api_active_requests",
            "legendFormat": "Active"
          }
        ]
      }
    ],
    "annotations": {
      "list": [
        {
          "name": "Drift Alerts",
          "expr": "finsentinel_data_drift_alert == 1",
          "step": "60s",
          "titleFormat": "Drift detected",
          "tagKeys": "instance",
          "hide": false
        }
      ]
    },
    "templating": {
      "list": []
    }
  }